# This service's own environment.
#
# A module's API is configured by the module, not by the Shell and not by a
# sibling repository. `DotEnvEnvironmentPostProcessor` loads this file as the
# lowest-priority property source: a real environment variable always wins, and
# `application.yml` supplies a default for everything else.

SERVER_PORT={{BACKEND_PORT}}
MAX_FILE_SIZE=25MB
MAX_REQUEST_SIZE=26MB

# Object storage. The bucket is created per module and named after the module
# slug — it is never shared between modules.
MINIO_ENDPOINT={{MINIO_ENDPOINT}}
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET={{BUCKET}}
MINIO_REGION=us-east-1
