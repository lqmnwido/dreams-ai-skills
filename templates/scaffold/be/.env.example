# Copy to `.env` and adjust. Every key this service reads is listed here —
# `.env` is this module's, and the Shell's environment is not visible to it.

SERVER_PORT={{BACKEND_PORT}}
MAX_FILE_SIZE=25MB
MAX_REQUEST_SIZE=26MB

MINIO_ENDPOINT={{MINIO_ENDPOINT}}
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET={{BUCKET}}
MINIO_REGION=us-east-1
