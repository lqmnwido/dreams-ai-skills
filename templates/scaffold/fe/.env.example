# This module's own environment.
#
# A federated remote compiles separately from the Shell, so the Shell's `.env` is
# not visible here. Every value this module reads must be declared in this file —
# including its API base, which is namespaced by module so two remotes can never
# collide on the same key.

# Local addresses for the two containers this module talks to.
VUE_APP_MODUL=http://localhost:{{REMOTE_PORT}}
VUE_APP_MODUL_PORT={{REMOTE_PORT}}
VUE_APP_SHELL=http://localhost:3000
VUE_APP_SHELL_BASE=http://localhost:3000

# `on` publishes remoteEntry.js and the exposes; `off` serves the preview entry.
VUE_APP_REMOTE=on

# This module's own backend service. One key, one module, never shared.
{{API_BASE_ENV}}={{MODULE_BASE_URL}}
